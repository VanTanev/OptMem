    (("tskey-",), r"tskey-[a-z]+-(?=[\w-]*\d)[\w-]{16,}", 0, ">3.0", (), ()),
    (("whsec_",), r"whsec_[A-Za-z0-9+/=]{24,}", 0, ">3.0", (), ()),
    (("ya29.",), r"ya29\.[\w-]{20,}", 0, ">3.0", (), ()),
