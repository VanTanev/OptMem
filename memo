_credential_re = {}


def credential(text):
    """Whether text holds a credential. A regex compiles only once one of its
    keywords is in the text: most lines hold none, and compiling all of them
    would cost every run of memo tens of ms."""
    low = text.lower()
    for words, pattern, group, entropy, drop, keep in (CREDENTIAL_RULES +
                                                       CREDENTIAL_EXTRA):
        if not any(w in low for w in words):
            continue
        rx = _credential_re.get(pattern)
        if rx is None:
            rx = _credential_re[pattern] = re.compile(pattern, re.ASCII)
        for m in rx.finditer(text):
            # the scanners' rule: the group named, else the first one found
            secret = (m.group(group) if group else
                      next((g for g in m.groups() if g), None)) or m.group()
            if entropy:  # ">3.5" or ">=3.5", bits per character
                e, floor = shannon(secret), float(entropy.lstrip(">="))
                if e < floor or e == floor and "=" not in entropy:
                    continue  # too regular to be random: a placeholder
            if any(re.search(p, secret) for p in drop + CREDENTIAL_IGNORE):
                continue
            if all(re.search(p, secret) for p in keep):
                return True
    return False


def shannon(s):
    """Bits per character: a random key scores high, `xxxx` or `aaaa` low."""
    n = len(s)
    return -sum(c / n * math.log2(c / n) for c in Counter(s).values())


CREDENTIAL_REFUSAL = ("That looks like a credential, and a memory is "
                      "permanent. Record where the secret lives, never its "
                      "value.")


def check(text):
    text = text.strip()
    if not text:
        die("Empty. A memory is one line of text.")
    lines = text.splitlines()
    if len(lines) > 1:
        die("%d lines. A memory is one line: merge them, or note them "
            "separately." % len(lines))
    n = len(text.encode())
    if n > ENTRY_CHARS:
        die("Too long: %d bytes, limit %d. Accented characters cost 2 bytes. "
            "Compress it further." % (n, ENTRY_CHARS))
    if credential(text):
        die(CREDENTIAL_REFUSAL)
    return text


def handover(sub, line="<your line>"):
    """The order that hands a line to `memo <sub> -` on stdin, through a
    quoted heredoc. Memories quote commands, and a shell expands `...`,
    $(...) and $VAR inside "...": a line retyped from them would run code or
    lose words. `<<'MEMO'` expands nothing, and no one line can end it early
    but `MEMO` itself, which is refused as empty."""
    return "%s %s - <<'MEMO'\n%s\nMEMO" % (ME, sub, line)


def given(arg):
    """The text of a memory as passed: the argument itself, or, for `-`, the
    line on stdin. Reading stops one character past what any memory can be
    (4 bytes a character, plus a CRLF), so a runaway pipe is refused, not
    read whole."""
    if arg != "-":
        return arg
    cap = 4 * ENTRY_CHARS + 2
    text = sys.stdin.read(cap + 1)
    if len(text) > cap:
        die("Too long: more than %d characters on stdin, limit %d bytes. "
            "Compress it further." % (cap, ENTRY_CHARS))
    return text.lstrip("\ufeff")  # the byte-order mark some Windows pipes add


# ---------------------------------------------------------------- naps

def pending(d, T, limit=None):
    """Blocks that can be built and have not been, smallest first. Each level
    file holds a dense prefix, so its length says exactly how far that level
    got: this costs one stat per level, never a scan."""
    todo, size = [], 2
    while size <= T:
        have = count(tree_path(d, size), TREE_REC)
        for k in range(have, T // size):
            todo.append((k * size, (k + 1) * size))
            if limit and len(todo) >= limit:
                return todo
        size *= 2
    return todo


def pending_count(d, T):
    """How many blocks pending() would list, without listing them. A level can
    hold MORE blocks than T needs -- T is a snapshot, and memories keep
    arriving while an agent reads -- so each level is clamped at zero."""
    n, size = 0, 2
    while size <= T:
        n += max(0, T // size - count(tree_path(d, size), TREE_REC))
        size *= 2
    return n


def nap_prompt(d, lo, hi, left, brief=False):
    if hi - lo <= RAW_MAX:
        body = "\n".join("  #%d %s %s" % e for e in log_slice(d, lo, hi))
    else:
        mid, halves = (lo + hi) // 2, []
        for a, b in ((lo, mid), (mid, hi)):
            s = tree_get(d, a, b)
            if s is None:
                # pending() lists a block only after its halves settled, so
                # a missing half is a blank record -- a corrupt write. Drop
                # it and the next nap rebuilds it.
                die("The summary of #%d-%d is blank. Run: %s forget %d-%d"
                    % (a, b - 1, ME, a, b - 1))
            halves.append("  #%d-%d %s" % (a, b - 1, s))
        body = "\n".join(halves)
    tail = "" if not left else "\n%s after this one." % (
        "1 compression remains" if left == 1 else
        "%d compressions remain" % left)
    if brief:
        # Chained naps: the full rules are the previous output, one step up
        # the context, so each nap of a backlog pays for them once.
        rules = "by the same rules as the last one (a bare nap repeats them).\n"
    else:
        # The verb is "distill", not "compress": a compressor squeezes every
        # input into the line, a distiller keeps the ranked few that last.
        rules = ("It stands in for them in every later wake; recall still "
                 "finds each memory word for word.\n"
                 "Wake shows it only after newer memories, so work shown here "
                 "as open has since finished: keep outcomes, leave open "
                 "states out.\n"
                 "Keep only lasting items, ones a later session would act on, "
                 "in this order:\n"
                 "1. Rules and preferences you were given.\n"
                 "2. Decisions, with their reasons.\n"
                 "3. Facts about systems that stay true.\n"
                 "4. Outcomes of finished work, one phrase each.\n"
                 "Fit the line by leaving out whole items, in full words. "
                 "Invent nothing. Never include a date or timestamp; start "
                 "directly with the lasting fact.\n")
    return ("Distill memories #%d-%d (%d memories) into one line of at most "
            "%d bytes%s%s\n%s\n%s\n"
            "Run: %s"
            % (lo, hi - 1, hi - lo, ENTRY_CHARS, ", " if brief else ".\n",
               rules, body, tail, handover("nap %d-%d" % (lo, hi - 1))))


def next_nap(d, T, brief=False):
    todo = pending(d, T, limit=1)
    if not todo:
        return None
    lo, hi = todo[0]
    return nap_prompt(d, lo, hi, pending_count(d, T) - 1, brief)


